# SecureBank Environment Configuration Template
# Copy this file to .env and configure with your specific environment values.
# Do NOT commit sensitive credentials or real secrets into version control.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB URI)
# For local replica set or MongoDB Atlas:
MONGO_URI=mongodb://localhost:27017/securebank?replicaSet=rs0

# JWT Secrets (Generate strong random 64-character strings for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long

# SMTP Email Configuration (Nodemailer)
# Gmail App Password or custom SMTP server credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# AI Provider Configuration (Google Gemini)
# Optional: If omitted, SecureBank automatically falls back to its deterministic verified core
GEMINI_API_KEY=your_gemini_api_key_here

# Suspicious Transaction & Fraud Anomaly Thresholds (Optional overrides)
FRAUD_HIGH_VALUE_THRESHOLD=50000
FRAUD_CRITICAL_VALUE_THRESHOLD=200000
FRAUD_VELOCITY_MAX_TRANSACTIONS=3
FRAUD_VELOCITY_WINDOW_MINUTES=10
FRAUD_FAILED_SPIKE_MAX=3
FRAUD_FAILED_SPIKE_WINDOW_MINUTES=15

